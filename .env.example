# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=cargogrid
POSTGRES_PASSWORD=cargogrid
POSTGRES_DB=cargogrid
PORT=3000

# Local dev (database from `docker compose up db`, exposed on 5433)
DATABASE_URL=postgresql://cargogrid:cargogrid@127.0.0.1:5433/cargogrid?schema=public

# Required. Signs access tokens; the API refuses to start without it. Generate: openssl rand -hex 32
JWT_SECRET=
# Optional: access token lifetime in seconds (default 900), refresh token lifetime in days (default 7)
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_DAYS=7
# Optional: bcrypt cost (default 10)
# BCRYPT_ROUNDS=10

# Used by `pnpm db:seed` for the demo accounts (<role>@cargogrid.local). Change outside local dev.
# SEED_USER_PASSWORD=ChangeMe123!
